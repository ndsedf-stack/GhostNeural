from typing import Optional
from core.logger import logger
from core.models import Lead, AuditResult, EmailResult
from core.database import SessionLocal
from db.crud import is_opted_out
class GuardError(Exception):
"""Exception levée quand un guard échoue."""
pass
def legal_guard(lead: Lead) -> bool:
"""
Vérifie la conformité légale AVANT l'envoi.
Rejets :
- Email perso (gmail, hotmail, etc.)
- Email dans la DB opt-out
- Pas d'email du tout
"""
if not lead.email:
logger.warning(f"Lead {lead.nom} : pas d'email")
return False
# Email perso
personal_domains = ["gmail.com", "hotmail.com", "yahoo.com", "outlook.com", "free.fr", "orange.fr", "wanadoo.fr"]
if any(domain in lead.email.lower() for domain in personal_domains):
logger.warning(f"Lead {lead.nom} : email perso détecté ({lead.email})")
return False
# Opt-out
db = SessionLocal()
try:
if is_opted_out(db, lead.email):
logger.warning(f"Lead {lead.nom} : dans la liste opt-out")
return False
finally:
db.close()
return True
def quality_guard(audit: AuditResult, email: EmailResult) -> bool:
"""
Vérifie la qualité AVANT l'envoi.
Rejets :
- Score audit < 20
- Score confiance email < 0.6
- Spam score > 0.4
"""
if audit.score_global < 20:
logger.warning(f"Score audit trop faible : {audit.score_global}")
return False
if email.score_confiance < 0.6:
logger.warning(f"Score confiance trop faible : {email.score_confiance}")
return False
if email.spam_score > 0.4:
logger.warning(f"Spam score trop élevé : {email.spam_score}")
return False
return True
def combined_guard(lead: Lead, audit: AuditResult, email: EmailResult) -> tuple[bool, Optional[str]]:
"""
Applique tous les guards.
Returns:
(passed, reason)
"""
if not legal_guard(lead):
return False, "legal"
if not quality_guard(audit, email):
return False, "quality"
return True, None
