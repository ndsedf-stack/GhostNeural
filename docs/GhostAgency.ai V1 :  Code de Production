from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from core.logger import logger
from core.config import settings
import requests
app = FastAPI(title="Agent Email Sender (Lemlist)")
class SendEmailInput(BaseModel):
to: str
first_name: str
last_name: str
company_name: str
subject: str
body: str
audit_url: Optional[str] = None
class SendEmailOutput(BaseModel):
status: str
lemlist_id: Optional[str] = None
message: str
def send_via_lemlist(email_data: SendEmailInput) -> dict:
"""
Envoie un email via Lemlist API.
Docs: https://developer.lemlist.com
"""
url = f"https://api.lemlist.com/api/campaigns/{settings.LEMLIST_CAMPAIGN_ID}/leads/{email_data.to}"
headers = {
"Content-Type": "application/json"
}
payload = {
"email": email_data.to,
"firstName": email_data.first_name,
"lastName": email_data.last_name,
"companyName": email_data.company_name,
# Variables custom
"customFields": {
"emailSubject": email_data.subject,
"emailBody": email_data.body,
"auditUrl": email_data.audit_url or ""
}
}
try:
response = requests.post(
url,
json=payload,
auth=(settings.LEMLIST_API_KEY, "")
)
response.raise_for_status()
logger.info(f"Email envoyé via Lemlist à {email_data.to}")
return {
"status": "sent",
"lemlist_id": response.json().get("_id"),
"message": "Email ajouté à la campagne Lemlist"
}
except requests.exceptions.HTTPError as e:
logger.error(f"Erreur Lemlist API : {e}")
logger.error(f"Response: {e.response.text}")
raise HTTPException(status_code=500, detail=f"Lemlist API error: {e.response.text}")
except Exception as e:
logger.error(f"Erreur inattendue : {e}")
raise HTTPException(status_code=500, detail=str(e))
@app.post("/send", response_model=SendEmailOutput)
def send_email(input: SendEmailInput):
"""Endpoint pour envoyer un email via Lemlist."""
result = send_via_lemlist(input)
return SendEmailOutput(**result)
@app.get("/health")
def health_check():
return {"status": "healthy", "service": "email_sender"}
