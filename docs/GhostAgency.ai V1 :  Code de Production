import json
import re
from typing import Any, Optional, Dict
from core.logger import logger
def extract_json(raw_text: str, retry_count: int = 0) -> Optional[Dict[str, Any]]:
"""
Extrait du JSON d'un texte potentiellement bruité.
Gère :
- Markdown (```json ... ```)
- Texte avant/après le JSON
- JSON malformé (trailing commas, etc.)
- Multiples tentatives de parsing
"""
# Tentative 1 : parsing direct
try:
return json.loads(raw_text)
except json.JSONDecodeError:
pass
# Tentative 2 : extraire depuis markdown
json_match = re.search(r'```json\s*(.*?)\s*```', raw_text, re.DOTALL)
if json_match:
try:
return json.loads(json_match.group(1))
except json.JSONDecodeError:
pass
# Tentative 3 : trouver le premier { et dernier }
first_brace = raw_text.find('{')
last_brace = raw_text.rfind('}')
if first_brace != -1 and last_brace != -1 and first_brace < last_brace:
try:
json_str = raw_text[first_brace:last_brace + 1]
return json.loads(json_str)
except json.JSONDecodeError:
pass
# Tentative 4 : nettoyer les trailing commas
try:
# Retire les virgules avant } ou ]
cleaned = re.sub(r',\s*([}\]])', r'\1', raw_text)
return json.loads(cleaned)
except json.JSONDecodeError:
pass
# Échec
logger.error(f"Impossible de parser JSON après {retry_count + 1} tentatives")
logger.error(f"Texte reçu : {raw_text[:500]}...")
return None
def safe_json_parse(
raw_text: str,
expected_schema: Optional[Dict] = None,
default_value: Optional[Dict] = None
) -> Dict[str, Any]:
"""
Parse JSON avec fallback.
Args:
raw_text: Texte brut du LLM
expected_schema: Schéma Pydantic attendu (pour validation)
default_value: Valeur par défaut si parsing échoue
Returns:
Dict parsé ou valeur par défaut
"""
parsed = extract_json(raw_text)
if parsed is None:
logger.warning("Parsing JSON échoué, utilisation de la valeur par défaut")
return default_value or {}
# Validation optionnelle avec Pydantic
if expected_schema:
try:
expected_schema(**parsed)
except Exception as e:
logger.error(f"Validation schéma échouée : {e}")
return default_value or {}
return parsed
