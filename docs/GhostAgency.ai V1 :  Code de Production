from sqlalchemy.orm import Session
from sqlalchemy import and_
from typing import List, Optional
from db.models import Lead, OptOut, EmailLog
from datetime import datetime
# --- LEADS ---
def create_lead(db: Session, lead_data: dict) -> Lead:
lead = Lead(**lead_data)
db.add(lead)
db.commit()
db.refresh(lead)
return lead
def get_lead(db: Session, lead_id: int) -> Optional[Lead]:
return db.query(Lead).filter(Lead.id == lead_id).first()
def get_leads_by_status(db: Session, status: str) -> List[Lead]:
return db.query(Lead).filter(Lead.status == status).all()
def update_lead(db: Session, lead_id: int, update_data: dict) -> Lead:
lead = get_lead(db, lead_id)
for key, value in update_data.items():
setattr(lead, key, value)
lead.updated_at = datetime.utcnow()
db.commit()
db.refresh(lead)
return lead
# --- OPT-OUTS ---
def add_opt_out(db: Session, email: str, reason: str = None, source: str = "manual") -> OptOut:
opt_out = OptOut(email=email.lower(), reason=reason, source=source)
db.add(opt_out)
db.commit()
db.refresh(opt_out)
return opt_out
def is_opted_out(db: Session, email: str) -> bool:
return db.query(OptOut).filter(OptOut.email == email.lower()).first() is not None
def get_all_opt_outs(db: Session) -> List[OptOut]:
return db.query(OptOut).all()
# --- EMAIL LOGS ---
def create_email_log(db: Session, log_data: dict) -> EmailLog:
log = EmailLog(**log_data)
db.add(log)
db.commit()
db.refresh(log)
return log
def update_email_log(db: Session, log_id: int, update_data: dict) -> EmailLog:
log = db.query(EmailLog).filter(EmailLog.id == log_id).first()
for key, value in update_data.items():
setattr(log, key, value)
db.commit()
db.refresh(log)
return log
def get_email_logs_by_lead(db: Session, lead_id: int) -> List[EmailLog]:
return db.query(EmailLog).filter(EmailLog.lead_id == lead_id).all()
