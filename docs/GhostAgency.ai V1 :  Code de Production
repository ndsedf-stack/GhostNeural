from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session
from sqlalchemy import func
from core.database import get_db
from db import models
router = APIRouter()
@router.get("/dashboard")
def get_dashboard_stats(db: Session = Depends(get_db)):
"""Statistiques globales pour le dashboard."""
total_leads = db.query(func.count(models.Lead.id)).scalar()
by_status = db.query(
models.Lead.status,
func.count(models.Lead.id)
).group_by(models.Lead.status).all()
avg_score_audit = db.query(func.avg(models.Lead.score_audit)).scalar()
avg_score_confiance = db.query(func.avg(models.Lead.score_confiance)).scalar()
total_opt_outs = db.query(func.count(models.OptOut.id)).scalar()
return {
"total_leads": total_leads,
"by_status": dict(by_status),
"avg_score_audit": round(avg_score_audit or 0, 1),
"avg_score_confiance": round(avg_score_confiance or 0, 2),
"total_opt_outs": total_opt_outs
}
@router.get("/conversion")
def get_conversion_stats(db: Session = Depends(get_db)):
"""Statistiques de conversion."""
total_sent = db.query(func.count(models.EmailLog.id)).filter(
models.EmailLog.status == "sent"
).scalar()
total_opened = db.query(func.count(models.EmailLog.id)).filter(
models.EmailLog.status == "opened"
).scalar()
total_replied = db.query(func.count(models.EmailLog.id)).filter(
models.EmailLog.status == "replied"
).scalar()
open_rate = (total_opened / total_sent * 100) if total_sent > 0 else 0
reply_rate = (total_replied / total_sent * 100) if total_sent > 0 else 0
return {
"total_sent": total_sent,
"total_opened": total_opened,
"total_replied": total_replied,
"open_rate": round(open_rate, 1),
"reply_rate": round(reply_rate, 1)
}
