import asyncio
import httpx
from typing import List, Dict, Any
from core.logger import logger
from core.models import Lead, AuditResult, EmailResult
from core.guards import combined_guard
from core.database import SessionLocal
from core.cache import cache
from db import crud
AGENTS = {
"sourcing": "http://localhost:8001",
"enrich": "http://localhost:8002",
"audit": "http://localhost:8003",
"architecte": "http://localhost:8004",
"copywriter": "http://localhost:8005",
"email": "http://localhost:8006"
}
async def process_lead(
client: httpx.AsyncClient,
lead_data: dict,
db_session: Any
) -> Dict[str, Any]:
"""
Traite un lead de bout en bout (async).
Returns:
Dict avec status et raison
"""
try:
lead = Lead(**lead_data)
# Vérification opt-out immédiate
if not lead.email or crud.is_opted_out(db_session, lead.email):
return {
"lead": lead.nom,
"status": "rejected",
"reason": "opt_out_or_no_email"
}
# 1. ENRICHISSEMENT
cache_key_enrich = cache.generate_key("enrich", site_web=lead.site_web)
enrich = cache.get(cache_key_enrich)
if not enrich:
resp = await client.post(
f"{AGENTS['enrich']}/enrich",
json={"site_web": lead.site_web}
)
enrich = resp.json()
cache.set(cache_key_enrich, enrich, ttl=86400) # 24h
# 2. AUDIT
cache_key_audit = cache.generate_key("audit", site_web=lead.site_web, secteur=lead.secteur)
audit = cache.get(cache_key_audit)
if not audit:
resp = await client.post(
f"{AGENTS['audit']}/audit",
json={
"site_web": lead.site_web,
"secteur": lead.secteur,
"ville": lead.ville
}
)
audit = resp.json()
cache.set(cache_key_audit, audit, ttl=86400)
# 3. PROPOSITION
cache_key_prop = cache.generate_key("prop", secteur=lead.secteur, ville=lead.ville)
prop = cache.get(cache_key_prop)
if not prop:
resp = await client.post(
f"{AGENTS['architecte']}/proposition",
json={
"secteur": lead.secteur,
"ville": lead.ville,
"audit": audit
}
)
prop = resp.json()
cache.set(cache_key_prop, prop, ttl=3600) # 1h (moins de cache car plus spécifique)
# 4. EMAIL
resp = await client.post(
f"{AGENTS['copywriter']}/email",
json={
"lead": lead_data,
"audit": audit,
"proposition": prop
}
)
email = resp.json()
# 5. GUARDS
audit_obj = AuditResult(**audit)
email_obj = EmailResult(**email)
passed, reason = combined_guard(lead, audit_obj, email_obj)
if not passed:
return {
"lead": lead.nom,
"status": "rejected",
"reason": reason
}
# 6. SAUVEGARDE EN DB (statut = email_ready)
db_lead = crud.create_lead(db_session, {
**lead_data,
"score_audit": audit_obj.score_global,
"audit_data": audit,
"proposition_data": prop,
"email_objet": email_obj.objet,
"email_body": email_obj.email,
"email_cta": email_obj.cta,
"score_confiance": email_obj.score_confiance,
"spam_score": email_obj.spam_score,
"status": "email_ready"
})
logger.info(f"✅ Lead {lead.nom} traité avec succès (ID: {db_lead.id})")
return {
"lead": lead.nom,
"status": "success",
"lead_id": db_lead.id,
"score_audit": audit_obj.score_global,
"score_confiance": email_obj.score_confiance
}
except Exception as e:
logger.error(f"❌ Erreur traitement lead {lead_data.get('nom')} : {e}")
return {
"lead": lead_data.get("nom"),
"status": "error",
"reason": str(e)
}
async def run_pipeline_async(
ville: str,
secteur: str,
max_results: int = 10,
concurrency: int = 5
):
"""
Pipeline async avec concurrence contrôlée.
Args:
ville: Ville cible
secteur: Secteur d'activité
max_results: Nombre de leads à traiter
concurrency: Nombre de leads traités en parallèle
"""
db = SessionLocal()
try:
async with httpx.AsyncClient(timeout=60.0) as client:
# 1. SOURCING (synchrone pour l'instant)
resp = await client.post(
f"{AGENTS['sourcing']}/sourcing",
json={
"ville": ville,
"secteur": secteur,
"max_results": max_results
}
)
leads = resp.json()
logger.info(f"📊 {len(leads)} leads trouvés")
# 2. TRAITEMENT PARALLEL (par batch)
results = []
for i in range(0, len(leads), concurrency):
batch = leads[i:i + concurrency]
logger.info(f"🔄 Traitement batch {i//concurrency + 1} ({len(batch)} leads)")
tasks = [
process_lead(client, lead, db)
for lead in batch
]
batch_results = await asyncio.gather(*tasks)
results.extend(batch_results)
# 3. STATISTIQUES
success = sum(1 for r in results if r["status"] == "success")
rejected = sum(1 for r in results if r["status"] == "rejected")
errors = sum(1 for r in results if r["status"] == "error")
logger.info(f"""
═══════════════════════════════════════
📊 PIPELINE TERMINÉ
═══════════════════════════════════════
Total leads : {len(leads)}
✅ Succès : {success}
⛔ Rejetés : {rejected}
❌ Erreurs : {errors}
═══════════════════════════════════════
""")
return results
finally:
db.close()
# CLI
if _name_ == "_main_":
import argparse
parser = argparse.ArgumentParser(description="GhostAgency.ai Orchestrator")
parser.add_argument("--ville", required=True, help="Ville cible")
parser.add_argument("--secteur", required=True, help="Secteur d'activité")
parser.add_argument("--max", type=int, default=10, help="Nombre de leads")
parser.add_argument("--concurrency", type=int, default=5, help="Parallélisme")
args = parser.parse_args()
asyncio.run(run_pipeline_async(
ville=args.ville,
secteur=args.secteur,
max_results=args.max,
concurrency=args.concurrency
))
